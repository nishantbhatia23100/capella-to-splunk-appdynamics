# Copy to .env, fill in, then: set -a; source .env; set +a
# --- Couchbase Capella ---
CAPELLA_API_KEY=            # Capella management API v4 key (secret/token)
CB_CONNSTR=                 # e.g. couchbases://cb.xxxx.cloud.couchbase.com
CB_USER=                    # database access credentials (not the API key)
CB_PASSWORD=
CB_BUCKET=travel-sample     # bucket to test against
# --- AppDynamics (from Controller > Getting Started > Java agent) ---
APPD_CONTROLLER_HOST=       # e.g. mycompany.saas.appdynamics.com
APPD_ACCOUNT_NAME=
APPD_ACCESS_KEY=
